#!/usr/bin/env sh
# Committed executable (mode 100755) with a shebang so the hook fires
# whether git invokes it directly or via husky's wrapper (Issue #83).
# husky pre-commit hook -- run lint-staged (phpcs / phpstan on staged
# src/ PHP files). Skip gracefully when the dev tooling is not installed
# (e.g. a fresh git worktree without `composer install` / `npm install`),
# so commits there are not blocked by missing binaries.
if [ ! -f vendor/bin/phpcs ] || [ ! -f vendor/bin/phpstan ] || [ ! -d node_modules/lint-staged ]; then
  echo "husky: dev tooling not installed -- skipping pre-commit checks."
  exit 0
fi

npx lint-staged
