{
    "name": "mt8/wordpress-0.71-gold",
    "description": "Experimental port of the oldest WordPress (0.71-gold) to PHP 8.3 + MySQL 8.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpunit/phpunit": "^12.5",
        "behat/behat": "^3.31"
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "static-export": "php bin/static-export.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
