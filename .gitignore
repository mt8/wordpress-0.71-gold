# Claude Code -- project instructions and local state (agent worktrees etc.)
# / Claude Code -- プロジェクト指示とローカル状態(エージェント worktree 等)
CLAUDE.md
.claude/

# Composer / static analysis / test tooling
/vendor/
.phpcs.cache
.phpunit.cache
.phpunit.result.cache

# Static-export output (generated by `071 export`) / 静的書き出しの出力
/static-export/

# E2E (Playwright) tooling / E2E (Playwright) ツール
node_modules/
test-results/
playwright-report/
/playwright/.cache/

# Block editor, Issue #65 / #76 / #158 / ブロックエディタ
# npm dependencies and the bundled build output are artifacts, not source.
# The build source lives in tools/block-editor/; the build output is
# written into src/block-editor/assets/, served by Apache.
/tools/block-editor/node_modules/
/src/block-editor/assets/

# 071-env local config and generated overrides / 071-env のローカル設定と生成物
# `.071-env.override.json` is a per-developer local override, the analogue
# of wp-env's `.wp-env.override.json` -- it is not committed.
# `docker-compose.071-mappings.yml` is regenerated by 071-env on every run
# from the `mappings` field of `.071-env.json`; it is a build artifact.
/.071-env.override.json
/docker-compose.071-mappings.yml

# Generated b2config.php, Issue #195 / 生成される b2config.php
# Environment-specific config (DB credentials, blog settings). The
# committed template is src/b2config-sample.php; `071-env start`
# generates src/b2config.php from it, applying the `wpConfig` overrides
# of `.071-env.json`.
/src/b2config.php

# Uploaded media (src/wp-content/uploads/), Issue #93 / アップロード済みメディア
# Files uploaded through the block editor are user content, not source.
# The wp-content/uploads/YYYY/MM/ tree is created on demand by upload.php.
/src/wp-content/uploads/
