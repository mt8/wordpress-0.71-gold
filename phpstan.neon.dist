# EN: PHPStan configuration for WordPress 0.71-gold.
#     WordPress 0.71 IS WordPress core itself (not a plugin/theme), so every
#     function is defined within src/ and no WordPress core stubs are needed.
# JA: WordPress 0.71-gold 向けの PHPStan 設定。
#     WordPress 0.71 は WordPress コア自体(プラグイン/テーマではない)であり、
#     関数はすべて src/ 内に定義されるため WordPress コアスタブは不要。
parameters:
    level: 0
    paths:
        - src
        # EN: 071-cli (cli/php/, Issue #106) is a maintained tool, so its PHP
        #     is analysed here -- unlike the experimental src/block-editor/api/
        #     excluded below. Settled in docs/071-tooling.md section 3.6.
        # JA: 071-cli(cli/php/、Issue #106)は保守されるツールであるため、その
        #     PHP をここで解析する -- 下記で除外する実験的な
        #     src/block-editor/api/ とは異なる。docs/071-tooling.md
        #     セクション 3.6 で確定している。
        - cli/php
    # EN: The block editor (src/block-editor/, Issue #65 / #76) is a
    #     clearly-labelled experimental proof-of-concept -- a custom
    #     @wordpress/block-editor React app on a thin modern JSON backend,
    #     decoupled from the 2003 b2/cafelog code path. The whole directory is
    #     excluded: api/ is prototype code, not part of the maintained
    #     WordPress 0.71 surface, and app/ + assets/ are JavaScript, not PHP.
    # JA: ブロックエディタ(src/block-editor/、Issue #65 / #76)は明示的に
    #     実験的な概念実証であり、カスタム @wordpress/block-editor の React
    #     アプリを薄くモダンな JSON バックエンドに載せたもので、2003 年の
    #     b2/cafelog のコードパスとは切り離している。ディレクトリ全体を除外
    #     する: api/ は維持対象の WordPress 0.71 の表面ではない試作コードで
    #     あり、app/ と assets/ は PHP ではなく JavaScript である。
    excludePaths:
        - src/block-editor/*
